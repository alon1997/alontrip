# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# SerpApi API key (serpapi.com) — Japan / Korea / Hong Kong transit
SERPAPI_KEY=

# 高德 Web 服务 Key（restapi.amap.com）。大陆公交用这个；空则大陆只出打车估价
AMAP_KEY=

# DeepSeek API key — required, no default
DEEPSEEK_API_KEY=

# DeepSeek Anthropic-compatible base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# Port the backend listens on
APP_PORT=5003

# Independent MySQL (hackathontrip only). Never reuse botc_db / alonkitchen.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=hackathontrip
MYSQL_USER=hackathontrip
MYSQL_PASSWORD=

# Comma-separated browser origins allowed by CORS (no trailing slash).
# Defaults to the Vite dev (5173) and preview (4173) ports.
# Production: replace with the real frontend origin(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
